#include <tunables/global>

/usr/local/bin/python3.11 {
    #include <abstractions/base>

    deny /etc/** r,
    deny /var/** rw,

    network inet stream,

    /app/** rwk,
    /usr/local/lib/python3.11/** mr,

    deny /bin/** rmix,
    deny /usr/bin/** rmix,

    capability net_bind_service,
    deny capability sys_admin,
}
