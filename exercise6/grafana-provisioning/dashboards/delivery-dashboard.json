{
  "title": "ZAPPTTO Delivery Operations",
  "uid": "zap-delivery-ops",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Total Deliveries",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "total_deliveries", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "Pending Deliveries",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "pending_deliveries", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green"}, {"color": "red", "value": 11}]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Deliveries On The Way",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "on_the_way_deliveries", "refId": "A"}]
    },
    {
      "id": 4,
      "title": "Average Delivery Time (seconds)",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "rate(average_delivery_time_sum[1m]) / rate(average_delivery_time_count[1m])",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "title": "Delivery Metrics Over Time",
      "type": "timeseries",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "total_deliveries", "legendFormat": "Total", "refId": "A"},
        {"expr": "pending_deliveries", "legendFormat": "Pending", "refId": "B"},
        {"expr": "on_the_way_deliveries", "legendFormat": "On the way", "refId": "C"}
      ]
    },
    {
      "id": 6,
      "title": "Average Delivery Time Trend",
      "type": "timeseries",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "rate(average_delivery_time_sum[1m]) / rate(average_delivery_time_count[1m])",
        "legendFormat": "Average seconds",
        "refId": "A"
      }]
    }
  ]
}
